# Copy this file to docker/.env and fill in your real values.
# docker/.env is gitignored and never committed.
#
# VOIPMS_USERNAME  — sub-account username (e.g. 123456_mypbx)
# VOIPMS_PASSWORD  — sub-account SIP password
# VOIPMS_HOST      — VoIP.ms PoP hostname (e.g. houston1.voip.ms)
# VOIPMS_NET       — VoIP.ms signaling subnet for that PoP (check wiki.voip.ms/article/Servers)

VOIPMS_USERNAME=123456_yoursubaccount
VOIPMS_PASSWORD=yourpassword
VOIPMS_HOST=atlanta.voip.ms
VOIPMS_NET=0.0.0.0/0
ASTERISK_PUBLIC_IP=203.0.113.7
